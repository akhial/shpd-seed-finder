    <!--
      Shattered Pixel Dungeon v3.3.8 item artwork, GPL-3.0-or-later. These are
      resolved from the shared third-party assets directory that build.rs adds
      as a second source directory, so the binaries are not duplicated here.
      The licence and attribution ship alongside them, as the GPL requires of
      anything that conveys the artwork.
    -->
    <file alias="third_party/shattered-pixel-dungeon/items.png">items.png</file>
    <file alias="third_party/shattered-pixel-dungeon/item_icons.png">item_icons.png</file>
    <file alias="third_party/shattered-pixel-dungeon/LICENSE.txt" compressed="true">LICENSE.txt</file>
    <file alias="third_party/shattered-pixel-dungeon/ATTRIBUTION.md" compressed="true">ATTRIBUTION.md</file>

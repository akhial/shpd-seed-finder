<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>SeedSeeker</RootNamespace>
    <Version>0.10.0</Version>
    <AssemblyVersion>0.10.0.0</AssemblyVersion>
    <FileVersion>0.10.0.0</FileVersion>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\SeedSeeker.ico</ApplicationIcon>
    <Platforms>ARM64;x64</Platforms>
    <WindowsPackageType>None</WindowsPackageType>
    <WindowsAppSDKSelfContained>false</WindowsAppSDKSelfContained>
    <UseWinUI>true</UseWinUI>
    <UseVCMetaManaged>false</UseVCMetaManaged>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <!-- Program.cs supplies Main so seedseeker:// activations can be
         redirected to an already-running instance before XAML starts. -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'ARM64'">
    <PlatformTarget>ARM64</PlatformTarget>
    <RuntimeIdentifier>win-arm64</RuntimeIdentifier>
    <RustTarget>aarch64-pc-windows-msvc</RustTarget>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Platform)' == 'x64'">
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <RustTarget>x86_64-pc-windows-msvc</RustTarget>
  </PropertyGroup>
  <!-- Engine build flags. The seed search is allocation- and branch-bound, so
       both levers below are worth several percent and neither changes the
       seeds the engine reports.
       * The profile-guided profile is used only when pgo/ carries one recorded
         for this exact target. Profiles are keyed by mangled symbol name and
         the crate disambiguator differs per target, so one file cannot serve
         several targets; a missing file silently falls back to a plain build.
       * EngineIsa=avx2 raises the baseline to the x86-64-v3 microarchitecture
         level (Intel Haswell 2013+, AMD Excavator 2015+). The release workflow
         publishes that as a separate download; the default stays portable. -->
  <PropertyGroup>
    <EngineIsa Condition="'$(EngineIsa)' == ''">baseline</EngineIsa>
    <EnginePgoProfile>$([System.IO.Path]::GetFullPath('$(MSBuildProjectDirectory)\..\..\pgo\seed-seeker-$(RustTarget).profdata'))</EnginePgoProfile>
    <EngineRustFlags Condition="Exists('$(EnginePgoProfile)')">-Cprofile-use=$(EnginePgoProfile)</EngineRustFlags>
    <EngineRustFlags Condition="'$(EngineIsa)' == 'avx2'">$(EngineRustFlags) -Ctarget-cpu=x86-64-v3</EngineRustFlags>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.8.260317003" />
    <!-- The exe icon covers Explorer; AppWindow.SetIcon needs the .ico on
         disk next to the binary for the title bar and taskbar. -->
    <Content Include="..\..\web\src\assets\dungeon-icons.png" Link="Assets\dungeon-icons.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\web\src\assets\ATTRIBUTION.md" Link="Assets\DUNGEON-ICONS-ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets\SeedSeeker.ico" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\android\app\src\main\assets\third_party\shattered-pixel-dungeon\catalog-v4.0.0.json" Link="Assets\catalog-v4.0.0.json" CopyToOutputDirectory="PreserveNewest" />
    <!-- Upstream GPL-3.0-or-later item artwork, shared with the Android app rather
         than duplicated here. Shipping the art means shipping its notices too. -->
    <Content Include="..\..\android\app\src\main\assets\third_party\shattered-pixel-dungeon\items.png" Link="Assets\items.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\android\app\src\main\assets\third_party\shattered-pixel-dungeon\item_icons.png" Link="Assets\item_icons.png" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\android\app\src\main\assets\third_party\shattered-pixel-dungeon\LICENSE.txt" Link="Assets\LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="..\..\android\app\src\main\assets\third_party\shattered-pixel-dungeon\ATTRIBUTION.md" Link="Assets\ATTRIBUTION.md" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="BuildRustEngine" BeforeTargets="Build">
    <Error Condition="'$(RustTarget)' == ''" Text="Build with -p:Platform=ARM64 or -p:Platform=x64; platform '$(Platform)' has no Rust target mapping." />
    <Error Condition="'$(EngineIsa)' != 'baseline' AND '$(EngineIsa)' != 'avx2'" Text="EngineIsa must be 'baseline' or 'avx2', not '$(EngineIsa)'." />
    <Error Condition="'$(EngineIsa)' == 'avx2' AND '$(Platform)' != 'x64'" Text="EngineIsa=avx2 is an x86-64 microarchitecture level and does not apply to platform '$(Platform)'." />
    <Exec WorkingDirectory="..\.." Command="cargo build --release -p shpd-seedfinder-ffi --target $(RustTarget)" EnvironmentVariables="RUSTFLAGS=$(EngineRustFlags)" />
    <Copy SourceFiles="..\..\target\$(RustTarget)\release\shpd_seedfinder_ffi.dll" DestinationFolder="$(OutDir)" />
  </Target>
</Project>
